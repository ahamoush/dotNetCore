@host = http://localhost:5149

### جلب كل المشاريع
GET {{host}}/api/projects/all
Accept: application/json

### بحث + فلترة + صفحات
GET {{host}}/api/projects?search=web&status=1&pageNumber=1&pageSize=10&sortBy=name&descending=false
Accept: application/json

### جلب مشروع بالـ Id
GET {{host}}/api/projects/1
Accept: application/json

### إنشاء مشروع
POST {{host}}/api/projects
Content-Type: application/json

{
  "name": "Learning API",
  "description": "My first ASP.NET Core project"
}

### تعديل مشروع
PUT {{host}}/api/projects/1
Content-Type: application/json

{
  "name": "Learning API Updated",
  "description": "Updated description"
}

### Soft Delete لمشروع
DELETE {{host}}/api/projects/1

### جلب كل المهام
GET {{host}}/api/tasks
Accept: application/json

### جلب مهام مشروع معين
GET {{host}}/api/tasks?projectId=1
Accept: application/json

### إنشاء مهمة
POST {{host}}/api/tasks
Content-Type: application/json

{
  "title": "Setup database",
  "description": "Create tables with EF Core",
  "projectId": 1
}

### تعديل مهمة
PUT {{host}}/api/tasks/1
Content-Type: application/json

{
  "title": "Setup database",
  "description": "Done",
  "isCompleted": true
}

### حذف مهمة
DELETE {{host}}/api/tasks/1
